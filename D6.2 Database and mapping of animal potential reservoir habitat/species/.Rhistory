# ------------------------------------------------------------------------------
cat("--- Lancement du K-Fold (K=5) ---\n")
k <- 5
fold_p  <- sample(rep(1:k, length.out = nrow(p_env)))
fold_bg <- sample(rep(1:k, length.out = nrow(bg_env)))
auc_scores <- numeric(k)
for (i in 1:k) {
