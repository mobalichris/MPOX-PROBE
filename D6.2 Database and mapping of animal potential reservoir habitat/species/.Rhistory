lc_res <- as.factor(lc_res)
# 3. Combinaison de TOUTES les variables dans le Stack final (Bioclim + Env + Espèces + LC)
predictors <- c(bioclim_stack, dem_res, activity_chass_res,dist_res, species_res, lc_res)
print(predictors)
# ------------------------------------------------------------------------------
# ETAPE 2 : Préparation des Points et Analyse de Multicolinéarité
# ------------------------------------------------------------------------------
cat("--- Préparation des points d'occurrence et de background ---\n")
# Les occurrences sont chargées depuis le dossier principal (wd)
points_f <- st_read(file.path(wd, "Points.shp"))
occ_coords <- st_coordinates(points_f)[, c("X", "Y")]
set.seed(123)
bg_points <- spatSample(predictors[[1]], size = 10000, method = "random", xy = TRUE, values = FALSE)
p_env  <- extract(predictors, occ_coords)[, -1]
bg_env <- extract(predictors, bg_points)[, -1]
# Nettoyage des valeurs NA si présentes dans les extractions
p_env  <- na.omit(p_env)
bg_env <- na.omit(bg_env)
# Assurer que l'occupation du sol est bien reconnue comme un facteur
p_env$LandCover <- as.factor(p_env$LandCover)
bg_env$LandCover <- as.factor(bg_env$LandCover)
# --- Graphique 1 : Multicolinéarité ---
cat("--- Analyse de la multicolinéarité (Variables continues et espèces) ---\n")
# R isolera automatiquement LandCover et fera la matrice sur Bioclim, Env et Espèces
numeric_vars <- sapply(bg_env, is.numeric)
cor_matrix <- cor(bg_env[, numeric_vars], use = "complete.obs")
png(filename = file.path(wd, "Multicolinearite_Corrplot_Clean.png"), width = 2400, height = 2400, res = 300)
corrplot(cor_matrix, method = "color", type = "upper", order = "hclust",
addCoef.col = "black", number.cex = 0.4, tl.col = "grey10", tl.srt = 45, tl.cex = 0.65,
col = colorRampPalette(c("#7b3294", "#ffffbf", "#008837"))(200),
main = "\nMatrice de Corrélation Globale", mar = c(0,0,2,0))
dev.off()
# ------------------------------------------------------------------------------
# ETAPE 3 : Validation Croisée (5-Fold)
# ------------------------------------------------------------------------------
cat("--- Lancement du K-Fold (K=5) ---\n")
k <- 5
fold_p  <- sample(rep(1:k, length.out = nrow(p_env)))
fold_bg <- sample(rep(1:k, length.out = nrow(bg_env)))
auc_scores <- numeric(k)
for (i in 1:k) {
cat("-> Traitement du Pli (Fold)", i, "/", k, "\n")
train_p  <- p_env[fold_p != i, ]
train_bg <- bg_env[fold_bg != i, ]
test_p   <- p_env[fold_p == i, ]
test_bg  <- bg_env[fold_bg == i, ]
pa_train   <- c(rep(1, nrow(train_p)), rep(0, nrow(train_bg)))
env_train  <- rbind(train_p, train_bg)
model_k <- MaxEnt(x = env_train, p = pa_train)
pred_p  <- predict(model_k, test_p, type = "cloglog")
pred_bg <- predict(model_k, test_bg, type = "cloglog")
n_p  <- length(pred_p)
n_bg <- length(pred_bg)
u_stat <- wilcox.test(pred_p, pred_bg, alternative = "greater")$statistic
auc_scores[i] <- u_stat / (as.numeric(n_p) * as.numeric(n_bg))
cat("   AUC pour le pli", i, ":", round(auc_scores[i], 3), "\n")
}
mean_auc <- mean(auc_scores)
mean_auc
sd_auc <- sd(auc_scores)
cat("Moyenne AUC :", mean_auc, "\n")
# Enregistrement du graphique K-Fold GGplot
df_auc <- data.frame(Fold = paste("Pli", 1:k), AUC = auc_scores)
gg_auc <- ggplot(df_auc, aes(x = Fold, y = AUC)) +
geom_bar(stat = "identity", fill = "#3182bd", alpha = 0.85, width = 0.5) +
geom_hline(yintercept = mean_auc, linetype = "dashed", color = "#e41a1c", linewidth = 1) +
geom_text(aes(label = round(AUC, 3)), vjust = -0.5, fontface = "bold", size = 3.5) +
scale_y_continuous(limits = c(0, 1.1)) +
labs(title = "Validation Croisée K-Fold (AUC)",
subtitle = paste0("Moyenne : ", round(mean_auc, 3), " | SD : ", round(sd_auc, 3))) +
theme_minimal()
gg_auc
ggsave(filename = file.path(wd, "Validation_Kfold_GGplot.png"), plot = gg_auc, width = 6, height = 4.5, dpi = 300)
# ------------------------------------------------------------------------------
# ETAPE 4 : Modèle Global Final et Importance des Variables
# ------------------------------------------------------------------------------
cat("\n--- Entraînement du modèle final global ---\n")
pa_final  <- c(rep(1, nrow(p_env)), rep(0, nrow(bg_env)))
env_final <- rbind(p_env, bg_env)
maxent_final <- MaxEnt(x = env_final, p = pa_final)
import_data <- maxent_final@results
contrib_rows <- grep("contribution", rownames(import_data), value = TRUE)
contributions <- import_data[contrib_rows, 1]
names(contributions) <- gsub(".contribution", "", contrib_rows)
# Histogramme de Contribution GGplot
df_contrib <- data.frame(Variable = names(contributions), Contribution = as.numeric(contributions))
df_contrib$Variable <- factor(df_contrib$Variable, levels = df_contrib$Variable[order(df_contrib$Contribution)])
gg_contrib <- ggplot(df_contrib, aes(x = Variable, y = Contribution)) +
geom_bar(stat = "identity", fill = "#31a354", alpha = 0.85) +
coord_flip() +
labs(title = "Contribution Relative des Variables", x = "Variables", y = "Contribution (%)") +
theme_minimal()
ggsave(filename = file.path(wd, "Contribution_Variables_GGplot.png"), plot = gg_contrib, width = 7, height = 5, dpi = 300)
# Radar Plot
order_radar <- names(contributions)
radar_df <- as.data.frame(t(contributions))
radar_df <- rbind(rep(100, ncol(radar_df)), rep(0, ncol(radar_df)), radar_df)
png(filename = file.path(wd, "Importance_Variables_Radar_Clean.png"), width = 2000, height = 2000, res = 300)
radarchart(radar_df, axistype = 1, pcol = "#31a354", pfcol = rgb(49/255, 163/255, 84/255, 0.3), plwd = 2.5,
cglcol = "grey70", cglty = 2, axislabcol = "grey40", caxislabels = seq(0, 100, 25), vlcex = 0.6,
title = "Profil de Contribution Écologique (%)")
dev.off()
# ------------------------------------------------------------------------------
# ETAPE 5 : Cartographie Finale et Affichage RStudio
# ------------------------------------------------------------------------------
cat("--- Projection cartographique finale ---\n")
prediction_map <- predict(predictors, maxent_final, type = "cloglog")
writeRaster(prediction_map, filename = file.path(wd, "MaxEnt_Prediction_Mpox_Kfold.tif"), overwrite = TRUE)
# Nettoyage et affichage synchrone dans RStudio
while (!is.null(dev.list())) dev.off()
par(mfrow = c(1, 2), mar = c(4, 4, 3, 1))
barplot(sort(contributions, decreasing = TRUE), horiz = TRUE, las = 1, cex.names = 0.55,
col = "#31a354", border = "transparent", main = "Contribution des Variables (%)")
plot(prediction_map, main = paste0("MaxEnt Habitat (AUC = ", round(mean_auc, 2), ")"), las = 1)
points(occ_coords, col = "black", pch = 20, cex = 0.55)
par(mfrow = c(1, 1))
